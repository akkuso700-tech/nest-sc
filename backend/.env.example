NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
UPLOADS_DIR=

MONGODB_URI=mongodb://127.0.0.1:27017/my-social-1
STORAGE_PROVIDER=local
S3_BUCKET=nest-sc-media
S3_REGION=us-east-1
S3_ENDPOINT=https://storage.nest-sc.com
S3_PUBLIC_BASE_URL=https://storage.nest-sc.com/nest-sc-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=MinioRootPass2026!
S3_PREFIX=nest-social
S3_OBJECT_ACL=
S3_FORCE_PATH_STYLE=true
HOSTINGER_UPLOAD_URL=https://upload.your-domain.com/upload.php
HOSTINGER_UPLOAD_TOKEN=replace-with-a-long-random-upload-token
HOSTINGER_PUBLIC_BASE_URL=https://upload.your-domain.com
HOSTINGER_UPLOAD_TIMEOUT_MS=15000

EMAIL_PROVIDER=resend
EMAIL_FROM=My Social <noreply@your-domain.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
EMAIL_VERIFICATION_TTL=10m
EMAIL_VERIFICATION_PEPPER=replace-with-a-long-random-pepper

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_PASSWORD_RESET_SECRET=replace-with-a-long-random-password-reset-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_EXPIRES_IN=30m

RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=200

LOOP_ASYNC_PROCESSING_ENABLED=true
LOOP_WORKER_MODE=embedded
LOOP_MAX_DURATION_SECONDS=90
LOOP_WORKER_POLL_MS=2000
LOOP_WORKER_STARTUP_GRACE_MS=0
LOOP_WORKER_LEASE_MS=1200000
LOOP_WORKER_STALE_MS=300000
LOOP_WORKER_JOB_TIMEOUT_MS=900000
LOOP_WORKER_MAX_ATTEMPTS=3
LOOP_RAW_BACKFILL_LIMIT=0
LOOP_BACKFILL_LEADER_LEASE_MS=300000
LOOP_BACKFILL_DOWNLOAD_TIMEOUT_MS=120000
LOOP_BACKFILL_MAX_SOURCE_BYTES=104857600
LOOP_UPLOAD_CONCURRENCY=3
FFMPEG_PATH=
