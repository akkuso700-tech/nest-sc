NODE_ENV=production
PORT=3000
CLIENT_URL=https://demo.nest-sc.com
CORS_ORIGINS=https://demo.nest-sc.com,https://www.demo.nest-sc.com
TRUST_PROXY=true
UPLOADS_DIR=

MONGODB_URI=replace-with-demo-mongodb-uri
STORAGE_PROVIDER=hostinger
HOSTINGER_UPLOAD_URL=https://upload-demo.nest-sc.com/upload.php
HOSTINGER_UPLOAD_TOKEN=replace-with-demo-upload-token
HOSTINGER_PUBLIC_BASE_URL=https://upload-demo.nest-sc.com
HOSTINGER_UPLOAD_TIMEOUT_MS=15000
LOOP_DIRECT_UPLOAD_ENABLED=true
LOOP_DIRECT_UPLOAD_URL=https://upload-demo.nest-sc.com/upload.php
LOOP_DIRECT_UPLOAD_SECRET=replace-with-a-separate-demo-32-character-secret
LOOP_DIRECT_UPLOAD_TICKET_TTL_SECONDS=600
LOOP_DIRECT_UPLOAD_CHUNK_BYTES=8388608
LOOP_HOSTINGER_MEDIA_ROOT=

EMAIL_PROVIDER=resend
EMAIL_FROM=Nest SC Demo <noreply@nest-sc.com>
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_VERIFICATION_TTL=10m
EMAIL_VERIFICATION_PEPPER=replace-with-demo-email-verification-pepper

JWT_ACCESS_SECRET=replace-with-long-random-demo-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-demo-refresh-secret
JWT_PASSWORD_RESET_SECRET=replace-with-long-random-demo-password-reset-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_EXPIRES_IN=30m

RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=200
