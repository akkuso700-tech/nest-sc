NODE_ENV=production
PORT=10000
CLIENT_URL=https://demo.nest-sc.com
CORS_ORIGINS=https://demo.nest-sc.com,https://www.demo.nest-sc.com
TRUST_PROXY=true
UPLOADS_DIR=

MONGODB_URI=replace-with-demo-mongodb-uri
STORAGE_PROVIDER=s3

S3_BUCKET=nest-sc-media
S3_SOURCE_BUCKET=nest-sc-sources-demo
S3_REGION=us-east-1
S3_ENDPOINT=https://storage.nest-sc.com
S3_PUBLIC_BASE_URL=https://storage.nest-sc.com/nest-sc-media
S3_ACCESS_KEY_ID=replace-with-demo-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-demo-s3-secret-key
S3_PREFIX=nest-social-demo
S3_OBJECT_ACL=
S3_FORCE_PATH_STYLE=true
DIRECT_VIDEO_UPLOADS_ENABLED=true
DIRECT_VIDEO_UPLOAD_PART_SIZE_BYTES=8388608
DIRECT_VIDEO_UPLOAD_URL_TTL_SECONDS=900
DIRECT_VIDEO_UPLOAD_SESSION_TTL_HOURS=24

HOSTINGER_UPLOAD_URL=https://upload-demo.nest-sc.com/upload.php
HOSTINGER_UPLOAD_TOKEN=replace-with-demo-upload-token
HOSTINGER_PUBLIC_BASE_URL=https://upload-demo.nest-sc.com
HOSTINGER_UPLOAD_TIMEOUT_MS=15000

LOOP_ASYNC_PROCESSING_ENABLED=true
LOOP_WORKER_MODE=external
LOOP_MAX_DURATION_SECONDS=90

EMAIL_PROVIDER=resend
EMAIL_FROM=Nest SC Demo <noreply@nest-sc.com>
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_VERIFICATION_TTL=10m
EMAIL_VERIFICATION_PEPPER=replace-with-demo-pepper

JWT_ACCESS_SECRET=replace-with-demo-access-secret
JWT_REFRESH_SECRET=replace-with-demo-refresh-secret
JWT_PASSWORD_RESET_SECRET=replace-with-demo-password-reset-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_PASSWORD_RESET_EXPIRES_IN=30m

RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=200
