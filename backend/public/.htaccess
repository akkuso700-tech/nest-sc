RewriteEngine On

# Vite, dosya adina icerik hash'i ekledigi icin /assets altindaki
# dosyalar yeni bir build cikana kadar guvenle uzun sure cache'lenebilir.
RewriteRule ^assets/ - [E=LONG_CACHE:1]

<IfModule mod_headers.c>
  Header always set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE

  <FilesMatch "^(index\.html|robots\.txt)$">
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Keep existing files/folders directly accessible
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for React Router
RewriteRule ^ index.html [L]
