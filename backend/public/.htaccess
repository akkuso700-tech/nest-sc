# ----------------------------------------------------------------------
# Nest Social - Hostinger Frontend Production .htaccess
# SPA Routing & High-Performance Browser Caching
# ----------------------------------------------------------------------

# 1. Guvenlik ve Performans Basliklari
<IfModule mod_headers.c>
  # Hash'li Vite varliklari (/assets/*), scriptler, stiller, fontlar ve medya dosyalari icin 1 yil kalici immutable cache
  <FilesMatch "\.(js|mjs|css|webp|avif|png|jpg|jpeg|gif|svg|ico|woff2|woff|ttf|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML, sitemap ve robots dosyalari asla onbellekte kilitlenmemeli; her zaman guncel olmali
  <FilesMatch "^(index\.html|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# 2. mod_expires Destegi (Apache & LiteSpeed Numarali Zaman Asimi)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: aninda dogrulama
  ExpiresByType text/html "access plus 0 seconds"

  # CSS ve JavaScript: 1 yil
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Medya ve Resimler: 1 yil
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # Web Fontlar: 1 yil
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# 3. Gzip/Deflate Sikistirma (Destekleyen sunucu modullerinde)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml
</IfModule>

# 4. React Router SPA URL Rewrite
RewriteEngine On

# Keep existing files/folders directly accessible
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback for React Router
RewriteRule ^ index.html [L]
